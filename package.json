{
  "name": "tvm-archive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out --listen 3000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "prebuild": "node scripts/catalogue.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "catalogue": "node scripts/catalogue.mjs",
    "seed:database": "node scripts/seed-supabase.mjs --apply",
    "media:upload": "node scripts/upload-media.mjs --apply"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "motion": "^13.5.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module"
}
