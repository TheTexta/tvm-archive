# Static admin client (public keys; access is enforced by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local/build tools only. Never use a NEXT_PUBLIC_ prefix for these.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: fetch catalogue from Supabase before each static build.
TVM_CATALOGUE_SOURCE=local
# R2 local importer
CLOUDFLARE_S3_API_ENDPOINT=
CLOUDFLARE_ACCESS_ID=
CLOUDFLARE_SECRET_KEY=
TVM_R2_BUCKET=
TVM_MEDIA_BASE_URL=
# Supabase function secrets: R2_ENDPOINT, R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY, R2_STAGING_BUCKET, R2_PUBLIC_BUCKET,
# TVM_MEDIA_BASE_URL, TVM_SITE_ORIGIN=https://dextery.dev,
# VERCEL_DEPLOY_HOOK.
